LIMITS_FETCHED:
-- Hierarchical limit fetching complete



SECTION 2: PERFORM VALIDATIONS


This section contains all limit checks and validations based on the limits
fetched from the hierarchical limit logic above.


2.1: Skip Validation if APPLY_LIMITS = 'X'


IF (APPLY_LIMITS = 'X') {
  -- Skip all limit validations
  RETURN SUCCESS;
}


2.2: Call Limit Fetching Procedure


CALL plp_schfundsfund_trxn_limit(
  Input.Folio_Number,
  Input.Transaction_Type,
  Input.Scheme_Code,
  NAV,
  Input.Trade_Date,
  SYS_REG_DATE,
  Sub_Trxn_Type,
  -- Output parameters:
  SCH_FUND_SUBFUND,
  MAX_VALUE,
  MIN_VALUE,
  MIN_UNITS,
  MAX_UNITS,
  MAX_PERC,
  MULTIPLES,
  NEW_MIN_VALUE,
  NEW_MAX_VALUE,
  AGGR_UNITS,
  AGGR_AMOUNT,
  AGGR_CLOSING_BAL,
  INCLUDE_CURRENT_BALANCE,
  Frequency,
  Insurance_ID,
  Swap_Option,
  Auto_Amount
);


2.3: Apply AMC-Specific Overrides to Limits


-- Accredited Investor Override
IF (nvl(Input.Accredit_Inv_Flag, 'N') = 'Y') {
  MIN_VALUE = Accredited_Inv_Limit;
  NEW_MIN_VALUE = MIN_VALUE;
}

-- AMC L Broker Invest Limit
IF (Input.AMC_Code = 'L' AND Input.Transaction_Type LIKE 'PRI%') {
  MIN_VALUE = Broker_Invest_Limit;
  NEW_MIN_VALUE = MIN_VALUE;
}

-- AMC 02 Tax Status/Occupation Limits
IF (Input.AMC_Code = '02'
    AND Input.Transaction_DB_CR = 'P'
    AND Input.Scheme_Code IN ('01', '02')) {

  IF (Tax_Status_Code IS NOT NULL AND Occupation_Code IS NOT NULL) {
    IF (Tax_Status_Occ_Limits_Record IS NOT NULL) {
      IF (Input.Scheme_Code = '01') {
        NEW_MIN_VALUE = Tax_Status_Occ_Limits_Record.new_pur_min_value;
        NEW_MAX_VALUE = Tax_Status_Occ_Limits_Record.new_pur_max_value;
      } ELSIF (Input.Scheme_Code = '02') {
        MIN_VALUE = Tax_Status_Occ_Limits_Record.addl_pur_min_value;
        MAX_VALUE = Tax_Status_Occ_Limits_Record.addl_pur_max_value;
      }
    }
  }
}

-- Adjust limits for new purchase
IF (nvl(Investor_Plan_Exists, 0) = 0 OR New_Purchase_Type_Flag = 'Y') {
  MAX_VALUE = nvl(NEW_MAX_VALUE, 0);
  MIN_VALUE = nvl(NEW_MIN_VALUE, 0);
}

-- Include current balance adjustment
IF (INCLUDE_CURRENT_BALANCE = 'Y') {
  MIN_VALUE = nvl(NEW_MIN_VALUE, 0);
  SUM_Purchase_Amt_DET = nvl(AGGR_AMOUNT, 0);
  SUM_Purchase_Units_DET = nvl(AGGR_UNITS, 0);
}





2.3.1: Prospect Folio Adjustment (AMC 'Y')


IF (AMC_Code = 'Y' 
    AND Input.Transaction_Type = 'P' 
    AND Prospect_Folio_Count > 0 
    AND CDT_Count_For_Prospect = 0) {
  New_Purchase_Type_Flag = 'Y';
}


2.3.2: Accredited Investor Limit Override (SIF)


IF (Accredited_Investor_Flag = 'Y' 
    AND OTHER_AMC_PARAMETER = 'SIF' 
    AND SIF_Folio_Exists_Count = 0 
    AND Accredited_Investor_Limit > 0) {
  MIN_VALUE = Accredited_Investor_Limit;
  NEW_MIN_VALUE = Accredited_Investor_Limit;
}


2.3.3: Online Cart SIF Minimum Override


IF (ALLOW_CARTING_ONLINE_SIF_FLAG = 'Y' 
    AND Cart_Reference_Number IS NOT NULL 
    AND Online_User_Flag = 'Y' 
    AND OTHER_AMC_PARAMETER = 'SIF') {
  Skip_Standard_Minimum_Check = 'Y';
}


2.3.4: SIF Existing Investor Adjustment


IF (OTHER_AMC_PARAMETER = 'SIF' AND SIF_Folio_Exists_Count > 0) {
  Apply_Existing_Investor_Limits = 'Y';
}


2.7: Purchase Units Validations (Unit-Based)


IF (Input.Transaction_Sign = '+'
    AND Input.Transaction_Mode <> 'R'
    AND Units_Amount_Flag = 'U'
    AND CHECK_LIMIT_PLUS = 'Y') {

  -- Max units and percentage checks
  IF (SCH_FUND_SUBFUND = 'S') {
    IF ((SUM_Purchase_Units_CDT + SUM_Purchase_Units_DET) > nvl(MAX_UNITS, 0)) {
      RAISE_ERROR('Transaction units falls above unit limits for this Trxn_type');
    }

    IF (nvl(Scheme_Controls_Closing_Balance, 0) > 0) {
      PERCENT = ((SUM_Purchase_Units_CDT + SUM_Purchase_Units_DET) / Scheme_Controls_Closing_Balance) * 100;
      IF (PERCENT > nvl(MAX_PERC, 0)) {
        RAISE_WARNING('Transaction units falls above Percentage limits for this Trxn_type');
      }
    }
  } ELSE {
    IF ((SUM_Purchase_Units_CDT + AGGR_UNITS) > nvl(MAX_UNITS, 0)) {
      RAISE_ERROR('Transaction units falls above unit limits for this Trxn_type');
    }

    IF (nvl(AGGR_CLOSING_BAL, 0) > 0) {
      PERCENT = ((SUM_Purchase_Units_CDT + AGGR_UNITS) / AGGR_CLOSING_BAL) * 100;
      IF (PERCENT > nvl(MAX_PERC, 0)) {
        RAISE_WARNING('Transaction units falls above Percentage limits for this Trxn_type');
      }
    }
  }

  -- Min units check
  IF (SCH_FUND_SUBFUND = 'S') {
    IF (INCLUDE_CURRENT_BALANCE = 'Y') {
      IF ((Current_Purchase_Units + SUM_Purchase_Units_DET) < nvl(MIN_UNITS, 0)
          AND Input.Transaction_Mode <> 'R') {
        RAISE_ERROR('Transaction units falls below unit limits for this Trxn_type');
      }