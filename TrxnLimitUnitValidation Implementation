B.7: Plan Auto Transaction Queries (for Systematic transactions)


- Swap_Option_SO_Scheme:
  SELECT swap_option
  FROM plan_auto_trxn pat
  WHERE pat.scheme_code = CASE
          WHEN nvl(CDT_Remarks, '*#@') LIKE '%<VCA Reverse Switch%' THEN
            Switch_In_Scheme_Code
          ELSE Input.Scheme_Code
        END
    AND auto_trxn_no = Auto_Trxn_No
    AND folio_no = Input.Folio_Number;

- Swap_Option_SI_Scheme:
  SELECT swap_option
  FROM plan_auto_trxn pat
  WHERE pat.to_scheme = CASE
          WHEN nvl(CDT_Remarks, '*#@') LIKE '%<VCA Reverse Switch%' THEN
            Switch_In_Scheme_Code
          ELSE Input.Scheme_Code
        END
    AND auto_trxn_no = Auto_Trxn_No
    AND folio_no = Input.Folio_Number;

- Frequency_SO_Scheme:
  SELECT periodicity
  FROM plan_auto_trxn pat
  WHERE pat.scheme_code = CASE
          WHEN nvl(CDT_Remarks, '*#@') LIKE '%<VCA Reverse Switch%' THEN
            Reverse_Switch_SI_Scheme_Code
          ELSE Input.Scheme_Code
        END
    AND auto_trxn_no = Auto_Trxn_No
    AND folio_no = Input.Folio_Number;

- Frequency_SI_Scheme:
  SELECT periodicity
  FROM plan_auto_trxn pat
  WHERE pat.to_scheme = CASE
          WHEN nvl(CDT_Remarks, '*#@') LIKE '%<VCA Reverse Switch%' THEN
            Input.Scheme_Code
          ELSE SO_Scheme_Code
        END
    AND auto_trxn_no = Auto_Trxn_No
    AND folio_no = Input.Folio_Number;

- Auto_Amount_SO_Scheme:
  SELECT auto_amount
  FROM plan_auto_trxn pat
  WHERE pat.scheme_code = CASE
          WHEN nvl(CDT_Remarks, '*#@') LIKE '%<VCA Reverse Switch%' THEN
            Reverse_Switch_SI_Scheme_Code
          ELSE Input.Scheme_Code
        END
    AND auto_trxn_no = Auto_Trxn_No
    AND folio_no = Input.Folio_Number;

- Auto_Amount_SI_Scheme:
  SELECT auto_amount
  FROM plan_auto_trxn pat
  WHERE pat.to_scheme = CASE
          WHEN nvl(CDT_Remarks, '*#@') LIKE '%<VCA Reverse Switch%' THEN
            Input.Scheme_Code
          ELSE SO_Scheme_Code
        END
    AND auto_trxn_no = Auto_Trxn_No
    AND folio_no = Input.Folio_Number;


B.8: Reverse Switch SI Scheme Code


- Reverse_Switch_SI_Scheme_Code:
  SELECT cdt.scheme_code
  FROM consolidated_daily_trades cdt
  WHERE cdt.user_code = Input.User_Code
    AND cdt.user_trxnno = Input.User_Transaction_Number
    AND cdt.auto_trxn_no = Auto_Trxn_No
    AND cdt.folio_no = Input.Folio_Number
    AND cdt.trxn_type IN (SELECT tt.trxn_type
                         FROM transaction_types tt
                         WHERE tt.trxn_db_cr = 'SI')
    AND cdt.remarks LIKE '%VCA Reverse Switch%';


B.9: SO Scheme Code (for SI transactions)


- SO_Scheme_Code_From_Det_Trades:
