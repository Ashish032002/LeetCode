    MAX_SWP_AMOUNT = NVL(REC_SUBFUND_SCHEME_LIMIT.max_swp_amount, 0);
    MICRO_SIP_MINIMUM = NVL(REC_SUBFUND_SCHEME_LIMIT.micro_sip_minimum, 0);
    MICRO_SIP_MAXIMUM = NVL(REC_SUBFUND_SCHEME_LIMIT.micro_sip_maximum, 0);
    MIN_SYS_UNITS = NVL(REC_SUBFUND_SCHEME_LIMIT.min_sys_units, 0);
    MAX_SYS_UNITS = NVL(REC_SUBFUND_SCHEME_LIMIT.max_sys_units, 0);

    -- Apply systematic overrides
    IF (Sub_Trxn_Type = 'M') {
      MIN_VALUE = MICRO_SIP_MINIMUM;
      MAX_VALUE = MICRO_SIP_MAXIMUM;
      NEW_MIN_VALUE = MIN_VALUE;
      NEW_MAX_VALUE = MAX_VALUE;
    } ELSIF (Sub_Trxn_Type IN ('S', 'A')) {
      MIN_VALUE = MIN_SWP_AMOUNT;
      MAX_VALUE = MAX_SWP_AMOUNT;
      NEW_MIN_VALUE = MIN_VALUE;
      NEW_MAX_VALUE = MAX_VALUE;

      IF (Sub_Trxn_Type = 'S') {
        MIN_UNITS = MIN_SYS_UNITS;
        MAX_UNITS = MAX_SYS_UNITS;
      }
    }

    -- Use aggregated holdings from sub-fund
    INCLUDE_CURRENT_BALANCE = 'N';
    SCH_FUND_SUBFUND = 'B';
    GOTO LIMITS_FETCHED;
  }

  IF (COUNT(REC_SUBFUND_SCHEME_LIMIT) > 1) {
    RAISE_ERROR('Too Many Rows for Sub Fund: ' || Input.Parent_Sub_Fund_Code ||
                ' trxn type: ' || Input.Transaction_Type);
  }
}

-- Priority 5: Fund level (if scheme has parent_fund and aggregate_flag='Y')
IF (Parent_Fund_Code IS NOT NULL AND Fund_Aggregate_Flag = 'Y') {
  -- Try history first
  IF (REC_FUND_HISTORY_LIMIT IS NOT NULL
      AND COUNT(REC_FUND_HISTORY_LIMIT) = 1) {

    MAX_VALUE = NVL(REC_FUND_HISTORY_LIMIT.max_value, 0);
