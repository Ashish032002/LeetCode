  NEW_MIN_VALUE = MIN_VALUE;
  NEW_MAX_VALUE = MAX_VALUE;
  MULTIPLES = NVL(REC_INSURANCE_LIMIT.multiples, 0);
  MIN_UNITS = NVL(REC_INSURANCE_LIMIT.min_units, 0);
  MAX_UNITS = NVL(REC_INSURANCE_LIMIT.max_units, 0);
  MAX_PERC = NVL(REC_INSURANCE_LIMIT.max_perc, 0);
  AGGR_UNITS = 0;
  AGGR_AMOUNT = 0;
  AGGR_CLOSING_BAL = 0;
  INCLUDE_CURRENT_BALANCE = 'N';
  SCH_FUND_SUBFUND = 'S';

  -- Insurance limits found; skip other hierarchy levels
  GOTO LIMITS_FETCHED;
}

-- Priority 2: Systematic limits (frequency present and sub-trxn-type is systematic)
IF (Input.Periodicity IS NOT NULL
    AND Input.Insurance_ID IS NULL
    AND Transaction_Nature = 'S') {

  -- Try history first
  IF (REC_SYS_HISTORY_LIMIT IS NOT NULL) {
    MIN_VALUE = NVL(REC_SYS_HISTORY_LIMIT.min_value, 0);
    MAX_VALUE = NVL(REC_SYS_HISTORY_LIMIT.max_value, 0);
    NEW_MIN_VALUE = MIN_VALUE;
    NEW_MAX_VALUE = MAX_VALUE;
    MULTIPLES = NVL(REC_SYS_HISTORY_LIMIT.multiples, 0);
    MIN_UNITS = NVL(REC_SYS_HISTORY_LIMIT.min_units, 0);
    MAX_UNITS = NVL(REC_SYS_HISTORY_LIMIT.max_units, 0);
    MAX_PERC = NVL(REC_SYS_HISTORY_LIMIT.max_perc, 0);
    INCLUDE_CURRENT_BALANCE = 'N';
    SCH_FUND_SUBFUND = 'S';

    GOTO LIMITS_FETCHED;
  }

  -- Fallback to current sys_scheme_limits
  IF (REC_SYS_LIMIT IS NOT NULL) {
    MIN_VALUE = NVL(REC_SYS_LIMIT.min_value, 0);
    MAX_VALUE = NVL(REC_SYS_LIMIT.max_value, 0);
    NEW_MIN_VALUE = MIN_VALUE;
    NEW_MAX_VALUE = MAX_VALUE;
    MULTIPLES = NVL(REC_SYS_LIMIT.multiples, 0);
    MIN_UNITS = NVL(REC_SYS_LIMIT.min_units, 0);
    MAX_UNITS = NVL(REC_SYS_LIMIT.max_units, 0);
    MAX_PERC = NVL(REC_SYS_LIMIT.max_perc, 0);
    INCLUDE_CURRENT_BALANCE = 'N';
    SCH_FUND_SUBFUND = 'S';

    GOTO LIMITS_FETCHED;
  }
}

-- Priority 3: Scheme-level limits (history first, then current)
IF (REC_SCHEME_HIST_LIMIT IS NOT NULL) {
  -- Assign base pack:
  MAX_VALUE = NVL(REC_SCHEME_HIST_LIMIT.max_value, 0);
  MIN_VALUE = NVL(REC_SCHEME_HIST_LIMIT.min_value, 0);
  MIN_UNITS = NVL(REC_SCHEME_HIST_LIMIT.min_units, 0);
  MAX_UNITS = NVL(REC_SCHEME_HIST_LIMIT.max_units, 0);
  MAX_PERC = NVL(REC_SCHEME_HIST_LIMIT.max_perc, 0);

  IF (Sub_Trxn_Type = 'S') {
    MULTIPLES = NVL(REC_SCHEME_HIST_LIMIT.sip_multiples, 0);
  } ELSE {
    MULTIPLES = NVL(REC_SCHEME_HIST_LIMIT.multiples, 0);
  }

  NEW_MIN_VALUE = NVL(REC_SCHEME_HIST_LIMIT.new_purch_minvalue, 0);
  NEW_MAX_VALUE = NVL(REC_SCHEME_HIST_LIMIT.new_purch_maxvalue, 0);

  -- Systematic detail fields
  MIN_SWP_AMOUNT = NVL(REC_SCHEME_HIST_LIMIT.min_swp_amount, 0);
  MAX_SWP_AMOUNT = NVL(REC_SCHEME_HIST_LIMIT.max_swp_amount, 0);
  MICRO_SIP_MINIMUM = NVL(REC_SCHEME_HIST_LIMIT.micro_sip_minimum, 0);
