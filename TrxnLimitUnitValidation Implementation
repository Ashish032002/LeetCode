B.21: Redemption Amount Aggregation (CDT)


- SUM_Redemption_Amount_CDT:
  SELECT SUM(nvl(amount, 0)) + SUM(nvl(units, 0) * nvl(NAV, 0))
  FROM consolidated_daily_trades
  WHERE folio_no = Input.Folio_Number
    AND scheme_code = Input.Scheme_Code
    AND trade_date = Input.Trade_Date
    AND trxn_type IN (SELECT trxn_type
                     FROM transaction_types
                     WHERE trxn_sign = '-');


B.22: Redemption Amount Aggregation (Det_Trades)


- SUM_Redemption_Amount_DET:
  SELECT SUM(nvl(amount, 0))
  FROM (SELECT nvl(SUM(plot_amount + total_tax), 0) amount
        FROM det_trades
        WHERE folio_no = Input.Folio_Number
          AND scheme_code = Input.Scheme_Code
          AND trade_date_time = Input.Trade_Date
          AND trxn_type IN (SELECT trxn_type
                           FROM transaction_types
                           WHERE trxn_sign = '-')
        UNION ALL
        SELECT nvl(SUM(plot_amount + total_tax), 0) amount
        FROM det_trades_deleted
        WHERE folio_no = Input.Folio_Number
          AND scheme_code = Input.Scheme_Code
          AND trade_date_time = Input.Trade_Date
          AND trxn_type IN (SELECT trxn_type
                           FROM transaction_types
                           WHERE trxn_sign = '-')
          AND redeemed_flag = 'X');


B.23: Current Transaction Redemption Amount (CDT)


- Current_Trxn_Redemption_Amount_CDT:
  SELECT round(nvl(cdt.amount, 0) + (nvl(cdt.units, 0) * nvl(NAV, 0)),
               ss.decimal_amount)
  FROM consolidated_daily_trades cdt, scheme_setup ss
  WHERE cdt.scheme_code = ss.scheme_code
    AND cdt.folio_no = Input.Folio_Number
    AND cdt.scheme_code = Input.Scheme_Code
    AND cdt.trade_date = Input.Trade_Date
    AND cdt.trxn_type = Input.Transaction_Type
    AND cdt.user_trxnno = Input.User_Transaction_Number
    AND cdt.user_code = Input.User_Code;


