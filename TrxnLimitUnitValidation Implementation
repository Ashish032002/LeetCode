- REC_INSURANCE_LIMIT:
  SELECT *
  FROM insurance_scheme_limits
  WHERE scheme_code = Input.Scheme_Code
  AND frequency = Input.Periodicity
  AND insurance_id = Input.Insurance_ID
  AND trxn_head = Input.Transaction_Type;

- REC_SYS_HISTORY_LIMIT:
  SELECT *
  FROM sys_scheme_limits_history sslh
  WHERE sslh.scheme_code = Input.Scheme_Code
  AND sslh.frequency = Input.Periodicity
  AND sslh.sys_flag = Systematic_Transaction_Type
  AND NVL(sslh.swap_option, 'N') = NVL(Swap_Option, 'N')
  AND NVL(Auto_Amount, 0) BETWEEN NVL(sslh.installment_from_amount, 0)
                          AND NVL(sslh.installment_to_amount, 9e18)
  AND Effective_Date BETWEEN sslh.effective_from_date
                     AND sslh.effective_to_date;

