    }

    -- Use aggregated holdings from fund level
    -- FUND_AGGR_UNITS, FUND_AGGR_AMOUNT, FUND_AGGR_CLOSING_BAL already set
    AGGR_UNITS = FUND_AGGR_UNITS;
    AGGR_AMOUNT = FUND_AGGR_AMOUNT;
    AGGR_CLOSING_BAL = FUND_AGGR_CLOSING_BAL;
    INCLUDE_CURRENT_BALANCE = 'N';
    SCH_FUND_SUBFUND = 'F';
    GOTO LIMITS_FETCHED;
  }

  -- Fallback to current fund limits
  IF (REC_FUND_LIMIT IS NOT NULL AND COUNT(REC_FUND_LIMIT) = 1) {

    MAX_VALUE = NVL(REC_FUND_LIMIT.max_value, 0);
    MIN_VALUE = NVL(REC_FUND_LIMIT.min_value, 0);
    MIN_UNITS = NVL(REC_FUND_LIMIT.min_units, 0);
    MAX_UNITS = NVL(REC_FUND_LIMIT.max_units, 0);
    MAX_PERC = NVL(REC_FUND_LIMIT.max_perc, 0);

    IF (Sub_Trxn_Type = 'S') {
      MULTIPLES = NVL(REC_FUND_LIMIT.sys_multiples, 0);
    } ELSIF (Sub_Trxn_Type = 'M') {
      MULTIPLES = NVL(REC_FUND_LIMIT.micro_multiples, 0);
    } ELSE {
      MULTIPLES = NVL(REC_FUND_LIMIT.multiples, 0);
    }

    NEW_MIN_VALUE = NVL(REC_FUND_LIMIT.new_min_value, 0);
    NEW_MAX_VALUE = NVL(REC_FUND_LIMIT.new_max_value, 0);

    MIN_SWP_AMOUNT = NVL(REC_FUND_LIMIT.min_swp_amount, 0);
