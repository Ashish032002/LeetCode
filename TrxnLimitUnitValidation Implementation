    MICRO_SIP_MINIMUM = NVL(REC_FUND_HISTORY_LIMIT.micro_sip_minimum, 0);
    MICRO_SIP_MAXIMUM = NVL(REC_FUND_HISTORY_LIMIT.micro_sip_maximum, 0);
    MIN_SYS_UNITS = NVL(REC_FUND_HISTORY_LIMIT.min_sys_units, 0);
    MAX_SYS_UNITS = NVL(REC_FUND_HISTORY_LIMIT.max_sys_units, 0);

    -- Apply systematic overrides
