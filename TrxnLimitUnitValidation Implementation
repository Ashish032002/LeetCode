      SUM_Purchase_Units_CDT = nvl(((SO_Units * SO_NAV) / NAV), 0);
    } ELSIF (SO_Amount IS NOT NULL AND SO_Amount > 0) {
      SUM_Purchase_Units_CDT = nvl((SO_Amount / NAV), 0);
    } ELSIF (SO_Units_DET IS NOT NULL AND SO_Units_DET > 0) {
      SUM_Purchase_Units_DET = nvl(((SO_Units_DET * SO_NAV) / NAV), 0);
    } ELSIF (SO_Amount_DET IS NOT NULL AND SO_Amount_DET > 0) {
      SUM_Purchase_Units_DET = nvl((SO_Amount_DET / NAV), 0);
