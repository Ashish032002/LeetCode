B.16: Additional Variables - SIF, Carting, and Prospect Handling


- ALLOW_CARTING_ONLINE_SIF_FLAG:
  SELECT key_value
  FROM application_parameters
  WHERE key_name = 'ALLOW_CARTING_ONLINE_SIF';

- OTHER_AMC_PARAMETER:
  SELECT nvl(key_value, 'N')
  FROM application_parameters
  WHERE key_name = 'OTHER_AMC';

- SIF_Folio_Exists_Count:
  IF (OTHER_AMC_PARAMETER = 'SIF' AND Minor_Flag IS NOT NULL) {
    SELECT COUNT(DISTINCT CASE
                            WHEN Minor_Flag = 'Y' THEN im.pan
                            ELSE im.subfund
                          END)
    FROM investor_master im,
         investor_plan ip,
         scheme_setup ss
    WHERE im.folio_no = ip.folio_no
      AND ip.scheme_code = ss.scheme_code
      AND im.folio_no = Input.Folio_Number
      AND ss.parent_subfund = Input.Parent_Sub_Fund_Code
      AND ip.current_units > 0
    UNION
    SELECT COUNT(DISTINCT CASE
                            WHEN Minor_Flag = 'Y' THEN jh.pan
                            ELSE jh.subfund
                          END)
    FROM joint_holders jh,
         investor_plan ip,
         scheme_setup ss
    WHERE jh.folio_no = ip.folio_no
      AND ip.scheme_code = ss.scheme_code
      AND jh.folio_no = Input.Folio_Number
      AND ss.parent_subfund = Input.Parent_Sub_Fund_Code
      AND ip.current_units > 0;
  } ELSE {
    Set 0;
  }

- Accredited_Investor_Limit:
  IF (Accredited_Investor_Flag = 'Y' 
      AND OTHER_AMC_PARAMETER = 'SIF' 
      AND SIF_Folio_Exists_Count = 0) {
    SELECT nvl(accredited_inv_limit, 0)
    FROM scheme_limits
    WHERE scheme_code = Input.Scheme_Code;
  } ELSE {
    Set 0;
  }

- Cart_Reference_Number:
  IF (ALLOW_CARTING_ONLINE_SIF_FLAG = 'Y') {
    SELECT cart_ref_no
    FROM consolidated_daily_trades
    WHERE user_code = Input.User_Code
      AND user_trxnno = Input.User_Transaction_Number
      AND trxn_type = Input.Transaction_Type;
  } ELSE {
    Set NULL;
  }

- Online_User_Flag:
  SELECT online_user
  FROM user_master
  WHERE user_id = Input.User_Code;

- Prospect_Folio_Count:
  IF (AMC_Code = 'Y' AND Input.Transaction_Type = 'P') {
    SELECT COUNT(1)
    FROM prospect
    WHERE folio_no = Input.Folio_Number;
  } ELSE {
    Set 0;
  }

- CDT_Count_For_Prospect:
  IF (Prospect_Folio_Count > 0) {
    SELECT COUNT(1)
    FROM consolidated_daily_trades
    WHERE folio_no = Input.Folio_Number;
  } ELSE {
    Set 0;
  }


