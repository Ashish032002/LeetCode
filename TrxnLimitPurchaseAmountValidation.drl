package com.cams.core.rules.units

unit TrxnLimitPurchaseAmountValidationUnit

import com.cams.core.api.requests.RuleEngineRequest
import com.cams.core.rules.utils.RuleUnitUtils
import com.cams.core.rules.utils.TrxnLimitValidationUtils
import java.math.BigDecimal

rule "TrxnLimit - Purchase Amount Too Many Scheme Rows"
when
    $request: /ruleEngineRequest[
        TrxnLimitValidationUtils.isPurchaseAmtBaseGuardPassed($request),
        TrxnLimitValidationUtils.isPurchaseAmtTooManySchemeRows($request)
    ]
then
    $request.getErrorDetails().addErrorForCode("3830014",
        TrxnLimitValidationUtils.getPurchaseAmtSchemeCode($request));
end

rule "TrxnLimit - Purchase Amount Too Many SubFund Rows"
when
    $request: /ruleEngineRequest[
        TrxnLimitValidationUtils.isPurchaseAmtBaseGuardPassed($request),
        TrxnLimitValidationUtils.isPurchaseAmtTooManySubFundRows($request)
    ]
then
    $request.getErrorDetails().addErrorForCode("3830015",
        TrxnLimitValidationUtils.getPurchaseAmtParentSubFundCode($request),
        TrxnLimitValidationUtils.getPurchaseAmtTxnTypeName($request));
end

rule "TrxnLimit - Purchase Amount Too Many Fund Rows"
when
    $request: /ruleEngineRequest[
        TrxnLimitValidationUtils.isPurchaseAmtBaseGuardPassed($request),
        TrxnLimitValidationUtils.isPurchaseAmtTooManyFundRows($request)
    ]
then
    $request.getErrorDetails().addErrorForCode("3830016",
        TrxnLimitValidationUtils.getPurchaseAmtParentFundCode($request),
        TrxnLimitValidationUtils.getPurchaseAmtTxnTypeName($request));
end

rule "TrxnLimit - Purchase Amount Exceeds Maximum"
when
    $request: /ruleEngineRequest[
        TrxnLimitValidationUtils.isPurchaseAmtSignGuardPassed($request),
        TrxnLimitValidationUtils.getPurchaseAmtEffectiveMax($request).compareTo(BigDecimal.ZERO) > 0,
        TrxnLimitValidationUtils.getPurchaseAmtTotal($request).compareTo(TrxnLimitValidationUtils.getPurchaseAmtEffectiveMax($request)) > 0
    ]
then
    $request.getErrorDetails().addErrorForCode("3830001",
        TrxnLimitValidationUtils.getPurchaseAmtTotal($request).toPlainString(),
        TrxnLimitValidationUtils.getPurchaseAmtEffectiveMax($request).toPlainString());
end

rule "TrxnLimit - Purchase Amount Min Value Zero"
when
    $request: /ruleEngineRequest[
        TrxnLimitValidationUtils.isPurchaseAmtSignGuardPassed($request),
        TrxnLimitValidationUtils.getPurchaseAmtEffectiveMin($request).compareTo(BigDecimal.ZERO) == 0
    ]
then
    $request.getErrorDetails().addErrorForCode("3830002");
end

rule "TrxnLimit - Purchase Amount Below Minimum"
when
    $request: /ruleEngineRequest[
        TrxnLimitValidationUtils.isPurchaseAmtSignGuardPassed($request),
        TrxnLimitValidationUtils.getPurchaseAmtEffectiveMin($request).compareTo(BigDecimal.ZERO) > 0,
        !TrxnLimitValidationUtils.isPurchaseAmtSkipMinCheck($request),
        TrxnLimitValidationUtils.getPurchaseAmtMinTotal($request).compareTo(TrxnLimitValidationUtils.getPurchaseAmtEffectiveMin($request)) < 0
    ]
then
    $request.getErrorDetails().addErrorForCode("3830003",
        TrxnLimitValidationUtils.getPurchaseAmtMinTotal($request).toPlainString(),
        TrxnLimitValidationUtils.getPurchaseAmtEffectiveMin($request).toPlainString());
end

rule "TrxnLimit - Purchase Amount Not In Multiples"
when
    $request: /ruleEngineRequest[
        TrxnLimitValidationUtils.isPurchaseAmtSignGuardPassed($request),
        TrxnLimitValidationUtils.getPurchaseAmtEffectiveMin($request).compareTo(BigDecimal.ZERO) > 0,
        !TrxnLimitValidationUtils.isPurchaseAmtSkipMultiplesCheck($request),
        TrxnLimitValidationUtils.getPurchaseAmtCurrentRounded($request)
            .remainder(TrxnLimitValidationUtils.getPurchaseAmtMultiples($request)).compareTo(BigDecimal.ZERO) != 0
    ]
then
    $request.getErrorDetails().addErrorForCode("3830004",
        TrxnLimitValidationUtils.getPurchaseAmtCurrentRounded($request).toPlainString(),
        TrxnLimitValidationUtils.getPurchaseAmtMultiples($request).toPlainString());
end
